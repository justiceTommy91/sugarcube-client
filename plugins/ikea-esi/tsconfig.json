{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "es6"],
    "sourceMap": true,
    "jsx": "react",
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "esModuleInterop": true,
    "noEmit": false,
    "noEmitOnError": true,
    "module": "esnext",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "outDir": "."
  },
  "exclude": ["./node_modules/*"],
  "include": ["./src/**/*"]
}
