---
import { FindMyFitViewerApp } from '@astro-components/find-my-fit/FindMyFitViewerApp'
import BaseLayout from '@layouts/BaseLayout.astro'
import { generateLocaleStaticPaths, type LocalePageProps, type Translations } from '@lib/static-paths-utils'

export async function getStaticPaths() {
    return generateLocaleStaticPaths()
}

const { locale, translations } = Astro.props as LocalePageProps
const { country, lang } = Astro.params
const market = `${country}/${lang}`
---

<BaseLayout
    locale={locale}
    market={market}
    title=""
    description=""
    allowSeo={false}
    showHeader={false}
    showFooter={false}
    showConsentScripts={true}
    showPricePackage={false}
    showScripts={true}
>
    <Fragment slot="head">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    </Fragment>
    <FindMyFitViewerApp client:only="react" locale={locale} market={market} translations={translations as Translations} />
</BaseLayout>

<style is:global>
    html, body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        height: 100%;
        overscroll-behavior: none;
    }
</style>
