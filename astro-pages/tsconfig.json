{
    "compilerOptions": {
        "jsx": "react-jsx",
        "moduleResolution": "node",
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "typeRoots": ["../node_modules/@types"],
        "baseUrl": ".",
        "paths": {
            "react": ["../node_modules/react"],
            "react-dom": ["../node_modules/react-dom"],
            "gatsby": ["./src/lib/gatsby-compat.ts"],
            "@gatsby/*": ["../src/*"],
            "@components/*": ["../src/components/*"],
            "@astro-components/*": ["./src/components/*"],
            "@hooks/*": ["../src/hooks/*"],
            "@utils/*": ["../src/utils/*"],
            "@models/*": ["../src/models/*"],
            "@apps/*": ["../src/apps/*"],
            "@constants/*": ["../src/constants/*"],
            "@services/*": ["../src/services/*"],
            "@lib/*": ["./src/lib/*"],
            "@layouts/*": ["./src/layouts/*"],
            "@providers/*": ["./src/providers/*"],
            "@astro-hooks/*": ["./src/hooks/*"],
            "@astro-services/*": ["./src/services/*"],
            "@locales/*": ["../locales/*"],
            "@style/*": ["../src/style/*"],
            "components/*": ["../src/components/*"],
            "hooks/*": ["../src/hooks/*"],
            "utils/*": ["../src/utils/*"],
            "models/*": ["../src/models/*"],
            "apps/*": ["../src/apps/*"],
            "constants/*": ["../src/constants/*"],
            "services/*": ["../src/services/*"],
            "style/*": ["../src/style/*"],
            "Renderer/*": ["../src/Renderer/*"]
        }
    },
    "exclude": ["node_modules", "dist"],
    "extends": "astro/tsconfigs/strict",
    "include": ["src/**/*", "src/types/**/*", "../src/types/**/*", "astro.config.mjs"]
}
