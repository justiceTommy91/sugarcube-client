{
    "name": "sugarcube-client",
    "version": "2.0.0",
    "private": true,
    "description": "sugarcube-client",
    "author": "Geomagical Labs",
    "keywords": [
        "gatsby"
    ],
    "scripts": {
        "start": "npm run develop",
        "start:blog": "ENABLE_BLOG_BUILD=true npm run develop",
        "start:no-overlay": "GATSBY_DISABLE_ERROR_OVERLAY=true npm run develop",
        "start:offline": "GATSBY_ENV=offline OFFLINE=true gatsby develop -H 0.0.0.0 -p 1090",
        "offline:server": "node scripts/offline-server/index.js",
        "develop": "gatsby develop -H 0.0.0.0 -p 1080",
        "develop:inspect": "gatsby develop -p 1080 --inspect",
        "develop:verbose": "gatsby develop -p 1080 --verbose",
        "develop:serve": "node serve.js",
        "build": "gatsby build",
        "build:blog": "ENABLE_BLOG_BUILD=true gatsby build",
        "serve": "gatsby serve",
        "serve:sourcemaps": "node sourcemaps.js",
        "clean": "gatsby clean",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src e2eTests --max-warnings=0",
        "stylelint": "stylelint **/*.scss",
        "autofix": "eslint --fix src e2etests",
        "setup:geomviewer": "cd geomviewerNpm && npm install && npm run build",
        "setup:gfxtest": "cd e2eTests/gfxtest && npm install && playwright install chromium",
        "setup:plannertest": "cd e2eTests/plannerTest && npm install && playwright install chromium",
        "setup:smokeTests": "npm install && playwright install chromium",
        "test": "jest",
        "test:watch": "npm run test -- --watch",
        "test:coverage": "jest --coverage --silent",
        "test:snapshot": "jest --updateSnapshot",
        "prettier": "prettier --write .",
        "test:e2e": "playwright test -c e2eTests/smokeTests",
        "test:gfx-api": "playwright test --config e2eTests/gfxtest --project=chromium",
        "test:gfx-api:browsers": "playwright test --config e2eTests/gfxtest",
        "test:gfx-api-baselines": "cross-env GEN_BASELINES=true npx playwright test --config e2eTests/gfxtest  --project=chromium",
        "test:e2e-room-builder": "playwright test --config e2eTests/plannerTest --project=chromium",
        "test:e2e-room-builder:browsers": "playwright test --config e2eTests/plannerTest",
        "prepare": "husky install",
        "lint:translations": "eslint --fix --ext .json node_modules/eslint-plugin-i18n-json/formatter.js locales/",
        "releasetool": "cd ./releaseTool && ./releaseTool.sh",
        "auth": "npx google-artifactregistry-auth"
    },
