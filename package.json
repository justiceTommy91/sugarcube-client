            "bash -c 'npm run typecheck'"
        ],
        "*.{js,jsx}": [
            "eslint",
            "prettier --write"
        ],
        "*.{scss, md, json, yml, html}": [
            "prettier --write"
        ]
    },
    "overrides": {
        "eslint-config-react-app": {
            "eslint-plugin-jest": "$eslint-plugin-jest"
        }
    }
